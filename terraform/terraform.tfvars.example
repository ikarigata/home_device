# cp terraform.tfvars.example terraform.tfvars して必要に応じて編集
project   = "home-device"
region    = "ap-northeast-1"
device_id = "kitchen-1"

# CloudFront はこの terraform で構築するので CORS は自動で wire される。
# ローカル開発（Vite dev server）からも API を叩きたいなら追加する：
# extra_allowed_origins = ["http://localhost:5173"]

s3_key_prefix   = "images"
url_ttl_seconds = 300
