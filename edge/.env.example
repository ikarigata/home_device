# エッジエージェント設定例。実機では systemd の EnvironmentFile 等で渡す。

# この機器の識別子（MQTTトピック / S3キーに使用）
DEVICE_ID=kitchen-1

# カメラ種別: 実機は fswebcam / 実機なし開発は mock
CAMERA=fswebcam

AWS_REGION=ap-northeast-1

# terraform apply の output から設定
S3_BUCKET=
S3_KEY_PREFIX=images

# AWS IoT Core 接続（未設定ならローカル1回撮影モード）
# 取得: aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_ENDPOINT=
IOT_CERT_FILE=/etc/home_device/certs/device.pem.crt
IOT_KEY_FILE=/etc/home_device/certs/device.pem.key
IOT_CA_FILE=/etc/home_device/certs/AmazonRootCA1.pem
